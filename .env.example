# Copy to .env.local and fill in. Nothing here is required for the mock demo.
# Do NOT commit real values or secrets. Chain config is never hard-coded in the app.

# Public site URL, used for metadata / Open Graph (e.g. https://profi.example)
NEXT_PUBLIC_SITE_URL=

# "Read Whitepaper" CTA target. If empty, the CTA is rendered disabled.
NEXT_PUBLIC_WHITEPAPER_URL=

