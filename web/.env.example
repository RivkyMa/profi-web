# Copy to .env.local and fill in. Nothing here is required for the mock demo.
# Do NOT commit real values or secrets. Chain config is never hard-coded in the app.

# Public site URL, used for metadata / Open Graph (e.g. https://profi.example)
NEXT_PUBLIC_SITE_URL=

# "Read Whitepaper" CTA target. If empty, the CTA is rendered disabled.
NEXT_PUBLIC_WHITEPAPER_URL=

# Deployment under a subdirectory, e.g. /profi-web for GitHub Pages.
# Leave empty for local development or hosting at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Set to true only when building the static GitHub Pages artifact.
# GITHUB_PAGES=true

# --- Used only in the optional integration phase (Phase 7) ---
# NEXT_PUBLIC_CHAIN_ID=
# NEXT_PUBLIC_RPC_URL=
