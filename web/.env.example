# Copy to .env.local and fill in. Nothing here is required for the mock demo.
# Do NOT commit real values or secrets. Chain config is never hard-coded in the app.

# Public site URL, used for metadata / Open Graph (e.g. https://profi.example)
NEXT_PUBLIC_SITE_URL=

# "Read Whitepaper" CTA target. If empty, the CTA is rendered disabled.
NEXT_PUBLIC_WHITEPAPER_URL=

# Deployment under a subdirectory, e.g. /profi-web for GitHub Pages.
# Leave empty for local development or hosting at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Set to true only when building the static GitHub Pages artifact.
# GITHUB_PAGES=true

# --- Chain mode (optional; the mock demo needs none of this) ---
# Everything about a network comes from here. Nothing is hard-coded or guessed.
# With a local anvil node, `npm run deploy:anvil` writes this block to
# web/.env.local for you. For a test network, fill it in from the deployment
# manifest (`RPC_URL=... npm run env:sync -- <chainId>` does that too).
#
# Anything missing or malformed keeps the app in mock mode and says what is wrong.
#
# NEXT_PUBLIC_DATA_MODE=chain
# NEXT_PUBLIC_CHAIN_ID=
# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_CHAIN_NAME=
# NEXT_PUBLIC_NATIVE_SYMBOL=ETH
# NEXT_PUBLIC_EXPLORER_URL=
# NEXT_PUBLIC_FACTORY_ADDRESS=
# NEXT_PUBLIC_REGISTRY_ADDRESS=
# NEXT_PUBLIC_VAULT_ADDRESS=
# NEXT_PUBLIC_STABLE_ADDRESS=
# SYMBOL:tokenAddress:oracleAddress, comma separated
# NEXT_PUBLIC_UNDERLYINGS=
# NEXT_PUBLIC_TEMPLATE_ID=0
# First block to scan for events (the deployment block)
# NEXT_PUBLIC_START_BLOCK=0
# Only needed for WalletConnect; browser wallets work without it
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
