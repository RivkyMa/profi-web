# Copy to contracts/.env (Foundry loads it). Never commit real values.

# `forge script ... --rpc-url testnet` reads this endpoint (see foundry.toml).
RPC_URL=

# Broadcaster key for a test network. Leave unset for anvil, which signs for
# an unlocked account (`npm run deploy:anvil`).
PRIVATE_KEY=

# Optional. Each defaults to the broadcaster.
FEE_RECIPIENT=
REGISTRY_OWNER=
VAULT_MANAGER=

# true (default): create three demo markets and one vault epoch
SEED_DEMO=true
# Oldest oracle price (seconds) that may set a strike
MAX_STRIKE_AGE_SECONDS=3600
# MockOracle staleness limit (seconds)
ORACLE_MAX_STALENESS=86400
