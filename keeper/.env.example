# Copy to keeper/.env. `npm run deploy:anvil` fills the block between the
# markers for a local chain. Never commit real values.

# JSON-RPC endpoint and the deployment to serve. Never guessed.
RPC_URL=
FACTORY_ADDRESS=
# Optional: the EpochVault. Without it only markets are served.
VAULT_ADDRESS=
# Optional: refuse to run unless the node reports this chain id.
CHAIN_ID=

# Who signs. On the local chain (31337) the node's first unlocked account is
# used if neither is set. Anywhere else one of them is required.
KEEPER_PRIVATE_KEY=
KEEPER_ADDRESS=

POLL_INTERVAL_MS=15000
# true: plan and simulate, send nothing
DRY_RUN=false
