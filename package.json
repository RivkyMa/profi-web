{
  "name": "profi",
  "private": true,
  "description": "PROFI monorepo: web app, Solidity contracts, keeper and shared package (testnet / mock data).",
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "web",
    "contracts",
    "keeper",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm test -w web",
    "test:contracts": "npm test -w contracts",
    "build:contracts": "npm run build -w contracts",
    "assets:optimize": "npm run assets:optimize -w web",
    "test:keeper": "npm test -w keeper",
    "abi:export": "node scripts/export-abis.mjs",
    "abi:check": "node scripts/export-abis.mjs --check",
    "chain:anvil": "anvil",
    "deploy:anvil": "npm run deploy:anvil -w contracts && node scripts/sync-env.mjs 31337",
    "deploy:testnet": "npm run deploy:testnet -w contracts",
    "env:sync": "node scripts/sync-env.mjs",
    "keeper": "npm start -w keeper",
    "keeper:once": "npm run once -w keeper",
    "e2e:anvil": "npm run e2e -w keeper"
  }
}
