{
  "name": "profi",
  "private": true,
  "description": "PROFI monorepo: web app, Solidity contracts, keeper and shared package (testnet / mock data).",
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "web",
    "contracts",
    "keeper",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm test -w web",
    "test:contracts": "npm test -w contracts",
    "build:contracts": "npm run build -w contracts",
    "assets:optimize": "npm run assets:optimize -w web"
  }
}
